{
    "name": "autogteck/identity-connector",
    "description": "Connecteur Laravel commun des APIs AutoGteck pour Identity : vérification des JWT, profils locaux, client de l'API Identity, webhooks.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "AutoGteck\\IdentityConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Migrations\\": "workbench/database/migrations/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AutoGteck\\IdentityConnector\\IdentityServiceProvider"
            ],
            "aliases": {
                "Identity": "AutoGteck\\IdentityConnector\\Facades\\Identity"
            }
        }
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
